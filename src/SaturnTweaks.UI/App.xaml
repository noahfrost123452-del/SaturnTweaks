<Application x:Class="SaturnTweaks.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SaturnTweaks.UI.Converters"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Typography.xaml" />
                <ResourceDictionary Source="Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVis" />
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
            <conv:BoolToEnabledTextConverter x:Key="BoolToEnabledText" />
            <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />
            <conv:PercentToHeightConverter x:Key="PercentToHeight" />
            <conv:BoolToMonitorTextConverter x:Key="BoolToMonitorText" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
