<Window x:Class="SaturnTweaks.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SaturnTweaks.UI.Views"
        mc:Ignorable="d"
        Title="Saturn Tweaks"
        Width="1400" Height="900"
        MinWidth="1180" MinHeight="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBaseBrush}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />  <!-- Title bar -->
                <RowDefinition Height="*" />   <!-- Content -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" /> <!-- Sidebar -->
                <ColumnDefinition Width="*" />   <!-- Main content -->
            </Grid.ColumnDefinitions>

            <!-- ─── CUSTOM TITLE BAR ───────────────────────────────── -->
            <Border Grid.Row="0" Grid.ColumnSpan="2"
                    Background="{StaticResource BackgroundDeepBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo + Name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="20,0,0,0">
                        <Ellipse Width="22" Height="22" Margin="0,0,8,0">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#7C5CFC" Offset="0.3" />
                                    <GradientStop Color="#5B8DEF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="SATURN"
                                   FontFamily="{StaticResource SaturnFontFamily}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" TWEAKS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="4,1,0,0" />
                    </StackPanel>

                    <!-- Admin indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding AdminStatusColor}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding AdminStatusText}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Content="─" Width="32" Height="32"
                                Style="{StaticResource SaturnGhostButton}"
                                Padding="0" FontSize="14"
                                Click="MinimizeButton_Click" />
                        <Button Content="□" Width="32" Height="32"
                                Style="{StaticResource SaturnGhostButton}"
                                Padding="0" FontSize="14" Margin="4,0,0,0"
                                Click="MaximizeButton_Click" />
                        <Button Content="✕" Width="32" Height="32"
                                Padding="0" FontSize="14" Margin="4,0,0,0"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand"
                                Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root" CornerRadius="6" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#EF4444" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─── SIDEBAR ────────────────────────────────────────── -->
            <Border Grid.Row="1" Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Nav groups -->
                    <ScrollViewer DockPanel.Dock="Top" Style="{StaticResource SaturnScrollViewer}"
                                  Margin="12,16,12,0">
                        <StackPanel>
                            <TextBlock Text="MAIN" Style="{StaticResource HeadingSmallText}"
                                       Margin="8,0,0,10" Opacity="0.5" />

                            <Button Content="◉  Overview"
                                    Style="{StaticResource SidebarNavItem}"
                                    Tag="{Binding OverviewActive}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Overview" />
                            <Button Content="▤  Performance"
                                    Style="{StaticResource SidebarNavItem}"
                                    Tag="{Binding PerformanceActive}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Performance" />
                            <Button Content="◇  Graphics"
                                    Style="{StaticResource SidebarNavItem}"
                                    Tag="{Binding GraphicsActive}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Graphics" />
                            <Button Content="⌁  Network"
                                    Style="{StaticResource SidebarNavItem}"
                                    Tag="{Binding NetworkActive}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Network" />
                            <Button Content="◎  Input"
                                    Style="{StaticResource SidebarNavItem}"
                                    Tag="{Binding InputActive}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Input" />
                            <Button Content="▥  Memory &amp; Storage"
                                    Style="{StaticResource SidebarNavItem}"
                                    Tag="{Binding MemoryActive}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Memory" />

                            <Separator Style="{StaticResource SaturnSeparator}" Margin="8,16" />
                            <TextBlock Text="TOOLS" Style="{StaticResource HeadingSmallText}"
                                       Margin="8,0,0,10" Opacity="0.5" />

                            <Button Content="▣  Game Profiles"
                                    Style="{StaticResource SidebarNavItem}"
                                    Tag="{Binding GameProfilesActive}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="GameProfiles" />
                            <Button Content="⚙  Advanced"
                                    Style="{StaticResource SidebarNavItem}"
                                    Tag="{Binding AdvancedActive}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Advanced" />
                            <Button Content="▥  Diagnostics"
                                    Style="{StaticResource SidebarNavItem}"
                                    Tag="{Binding DiagnosticsActive}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Diagnostics" />
                            <Button Content="↶  Restore Center"
                                    Style="{StaticResource SidebarNavItem}"
                                    Tag="{Binding RestoreActive}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Restore" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom: Settings -->
                    <Border DockPanel.Dock="Bottom" Padding="12,12">
                        <Button Content="⚙  Settings"
                                Style="{StaticResource SidebarNavItem}"
                                Tag="{Binding SettingsActive}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Settings" />
                    </Border>
                </DockPanel>
            </Border>

            <!-- ─── MAIN CONTENT AREA ─────────────────────────────── -->
            <Frame x:Name="ContentFrame"
                   Grid.Row="1" Grid.Column="1"
                   NavigationUIVisibility="Hidden"
                   Background="{StaticResource BackgroundBaseBrush}" />
        </Grid>
    </Border>
</Window>
