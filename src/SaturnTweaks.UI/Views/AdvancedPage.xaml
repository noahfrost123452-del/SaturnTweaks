<Page x:Class="SaturnTweaks.UI.Views.AdvancedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBaseBrush}"
      Title="Advanced">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Style="{StaticResource SaturnScrollViewer}"
                      Padding="32,28,16,28">
            <StackPanel>
                <TextBlock Text="Advanced Tweaks" Style="{StaticResource DisplayMediumText}" />
                <TextBlock Text="Kernel scheduling, registry, and system-level settings — all opt-in"
                           Style="{StaticResource BodySecondaryText}" Margin="0,4,0,16" />

                <!-- Warning banner -->
                <Border Background="#1AF59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                        CornerRadius="10" Padding="16,12" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="⚠  Advanced Settings" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="#F5C542" FontSize="13">
                            These tweaks modify kernel scheduling, registry settings, and Windows
                            services. Each has documented trade-offs — read the detail panel before
                            selecting any tweak. Dry Run is enabled by default. All changes are
                            reversible via the Restore Center.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <CheckBox IsChecked="{Binding UserHasAcknowledgedRisk}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="I have read the details for each tweak I plan to apply."
                                       Foreground="#F5C542" FontSize="13" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Controls -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Apply Selected" Style="{StaticResource SaturnPrimaryButton}"
                            Command="{Binding ApplySelectedCommand}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource SaturnToggle}" IsChecked="{Binding DryRunMode}" />
                        <TextBlock Text="Dry Run (recommended)" Margin="8,0,0,0"
                                   Style="{StaticResource BodySecondaryText}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,10"
                             Foreground="{StaticResource AccentPrimaryBrush}"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

                <Border Background="{StaticResource BackgroundElevatedBrush}" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding SessionSummary, Converter={StaticResource StringToVis}}">
                    <TextBlock Text="{Binding SessionSummary}" Style="{StaticResource BodySecondaryText}" />
                </Border>

                <!-- Tweak list — all unselected by default -->
                <ItemsControl ItemsSource="{Binding Tweaks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TweakRowCard}"
                                    Tag="{Binding IsPreviewed}"
                                    MouseLeftButtonDown="TweakRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding IsApplicable}"
                                              VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource HeadingMediumText}" FontSize="14" />
                                        <TextBlock Text="{Binding ShortDescription}"
                                                   Style="{StaticResource BodySecondaryText}"
                                                   FontSize="12" Margin="0,2,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="⚠ Requires restart" FontSize="11"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       Margin="0,0,8,0"
                                                       Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="🛡 Admin required" FontSize="11"
                                                       Foreground="{StaticResource InfoBrush}"
                                                       Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="6,3" CornerRadius="4"
                                            Margin="8,0" VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding RiskColor}" Opacity="0.15" />
                                        </Border.Background>
                                        <TextBlock Text="{Binding Risk}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding RiskColor}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Detail panel -->
        <Border Grid.Column="1" Background="{StaticResource BackgroundElevatedBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,0,0,0"
                Padding="24,28">
            <ScrollViewer Style="{StaticResource SaturnScrollViewer}">
                <StackPanel>
                    <TextBlock Text="PREVIEW BEFORE APPLYING" Style="{StaticResource HeadingSmallText}"
                               Opacity="0.5" Margin="0,0,0,20" />
                    <TextBlock Text="Select a tweak to read its full technical explanation before applying."
                               Style="{StaticResource BodySecondaryText}"
                               Visibility="{Binding SelectedTweak, Converter={StaticResource NullToVis}}" />
                    <StackPanel Visibility="{Binding SelectedTweak, Converter={StaticResource NotNullToVis}}">
                        <TextBlock Text="{Binding SelectedTweak.DisplayName}"
                                   Style="{StaticResource HeadingLargeText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedTweak.Category}"
                                   Style="{StaticResource CaptionText}" Margin="0,4,0,12" />
                        <TextBlock Text="PRE-APPLY PREVIEW — NO CHANGES MADE" FontSize="10"
                                   FontWeight="Bold" Foreground="{StaticResource AccentTertiaryBrush}"
                                   Margin="0,0,0,14" TextWrapping="Wrap" />
                        <TextBlock Text="Planned change" Style="{StaticResource HeadingSmallText}"
                                   Opacity="0.65" Margin="0,0,0,6" />
                        <Border Background="{StaticResource BackgroundCardBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="10,8" Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedTweak.ProposedChange}"
                                       Style="{StaticResource MonoValueText}" FontSize="11"
                                       TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="Windows setting location" Style="{StaticResource HeadingSmallText}"
                                   Opacity="0.65" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SelectedTweak.ChangeLocation}"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Margin="0,0,0,14" />
                        <TextBlock Text="Current Value" Style="{StaticResource HeadingSmallText}"
                                   Opacity="0.5" Margin="0,0,0,6" />
                        <Border Background="{StaticResource BackgroundCardBrush}" CornerRadius="6" Padding="10,7"
                                Margin="0,0,0,14">
                            <TextBlock Text="{Binding SelectedTweak.CurrentValue}"
                                       Style="{StaticResource MonoValueText}" FontSize="12" />
                        </Border>
                        <TextBlock Text="Technical Details" Style="{StaticResource HeadingSmallText}"
                                   Opacity="0.5" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SelectedTweak.DetailedExplanation}"
                                   Style="{StaticResource BodySecondaryText}" Margin="0,0,0,14" />
                        <TextBlock Text="Expected Benefit" Style="{StaticResource HeadingSmallText}"
                                   Opacity="0.5" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SelectedTweak.ExpectedBenefit}"
                                   Foreground="{StaticResource SuccessBrush}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />
                        <TextBlock Text="Trade-offs &amp; Risks" Style="{StaticResource HeadingSmallText}"
                                   Opacity="0.5" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SelectedTweak.PotentialDisadvantages}"
                                   Foreground="{StaticResource WarningBrush}" FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
