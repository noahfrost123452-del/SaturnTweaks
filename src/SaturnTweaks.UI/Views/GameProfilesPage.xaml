<Page x:Class="SaturnTweaks.UI.Views.GameProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBaseBrush}"
      Title="Game Profiles">

    <Grid Margin="32,28,32,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Game List -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock Text="Game Profiles" Style="{StaticResource DisplayMediumText}" />
                <TextBlock Text="Detect installed games, back up configs, and manage per-game settings"
                           Style="{StaticResource BodySecondaryText}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Scan Libraries" Style="{StaticResource SaturnPrimaryButton}"
                        Command="{Binding ScanLibrariesCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" />
            </StackPanel>

            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" Margin="0,0,0,10"
                         Foreground="{StaticResource AccentPrimaryBrush}"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />

            <Border DockPanel.Dock="Top" Background="{StaticResource BackgroundElevatedBrush}"
                    CornerRadius="8" Padding="10,6" Margin="0,0,0,12"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodySecondaryText}" />
            </Border>

            <!-- Manual add section -->
            <Border DockPanel.Dock="Top" Style="{StaticResource SaturnCard}" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="ADD GAME MANUALLY" Style="{StaticResource HeadingSmallText}"
                               Opacity="0.5" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource BackgroundElevatedBrush}"
                                CornerRadius="6" Padding="10,7">
                            <TextBox Text="{Binding ManualGameName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontSize="13" VerticalAlignment="Center"
                                     Tag="Game name" />
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource BackgroundElevatedBrush}"
                                CornerRadius="6" Padding="10,7">
                            <TextBox Text="{Binding ManualGamePath, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontSize="13" VerticalAlignment="Center"
                                     Tag="Install path" />
                        </Border>
                        <Button Grid.Column="4" Content="Browse"
                                Style="{StaticResource SaturnGhostButton}"
                                Command="{Binding BrowseGamePathCommand}" />
                        <Button Grid.Column="6" Content="Add"
                                Style="{StaticResource SaturnPrimaryButton}"
                                Command="{Binding AddManualGameCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Game list -->
            <ScrollViewer Style="{StaticResource SaturnScrollViewer}">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TweakRowCard}"
                                    MouseLeftButtonDown="Game_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource HeadingMediumText}" FontSize="14" />
                                        <TextBlock Text="{Binding InstallPath}"
                                                   Style="{StaticResource CaptionText}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="6,3" CornerRadius="4"
                                            Margin="8,0" VerticalAlignment="Center"
                                            Background="#1A7C5CFC" BorderBrush="#7C5CFC" BorderThickness="1">
                                        <TextBlock Text="{Binding SourceDisplay}" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentTertiaryBrush}" />
                                    </Border>
                                    <Border Grid.Column="2" VerticalAlignment="Center">
                                        <Border Style="{StaticResource StatusBadgeSafe}"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Installed" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}" />
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Game Detail Panel -->
        <Border Grid.Column="2" Background="{StaticResource BackgroundElevatedBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1" CornerRadius="12" Padding="24">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="GAME DETAILS"
                           Style="{StaticResource HeadingSmallText}"
                           Opacity="0.5" Margin="0,0,0,16" />

                <TextBlock DockPanel.Dock="Top" Text="Select a game to view options."
                           Style="{StaticResource BodySecondaryText}"
                           Visibility="{Binding SelectedGame, Converter={StaticResource NullToVis}}" />

                <StackPanel DockPanel.Dock="Top"
                            Visibility="{Binding SelectedGame, Converter={StaticResource NotNullToVis}}">
                    <TextBlock Text="{Binding SelectedGame.Name}"
                               Style="{StaticResource HeadingLargeText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedGame.SourceDisplay}"
                               Style="{StaticResource CaptionText}" Margin="0,4,0,12" />

                    <TextBlock Text="INSTALL PATH" Style="{StaticResource HeadingSmallText}"
                               Opacity="0.5" Margin="0,0,0,6" />
                    <Border Background="{StaticResource BackgroundCardBrush}" CornerRadius="6" Padding="10,7">
                        <TextBlock Text="{Binding SelectedGame.InstallPath}"
                                   Style="{StaticResource MonoValueText}" FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Button Content="Back Up Game Config" Margin="0,16,0,0"
                            Style="{StaticResource SaturnPrimaryButton}"
                            Command="{Binding BackupSelectedGameCommand}"
                            IsEnabled="{Binding IsBackingUp, Converter={StaticResource InverseBool}}" />

                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,8,0,0"
                                 Foreground="{StaticResource AccentPrimaryBrush}"
                                 Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="BACKUP HISTORY" Style="{StaticResource HeadingSmallText}"
                               Opacity="0.5" Margin="0,20,0,10" />

                    <TextBlock Text="No backups yet." Style="{StaticResource BodySecondaryText}"
                               Visibility="{Binding Backups.Count, Converter={StaticResource ZeroToVis}}" />

                    <ItemsControl ItemsSource="{Binding Backups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="0,0,0,6"
                                        Background="{StaticResource BackgroundCardBrush}"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayDate}"
                                                   Style="{StaticResource HeadingMediumText}" FontSize="13" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                                            <Run Text="{Binding OriginalPaths.Count}" />
                                            <Run Text=" files backed up" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Foreground="{StaticResource TextTertiaryBrush}">
                        Saturn Tweaks never modifies anti-cheat software, injects code into
                        games, or alters game binaries. Config backups copy settings files only.
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>
