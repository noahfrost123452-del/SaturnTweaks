<Page x:Class="SaturnTweaks.UI.Views.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBaseBrush}"
      Title="Overview">

    <ScrollViewer Style="{StaticResource SaturnScrollViewer}" Padding="32,28,32,32">
        <StackPanel>

            <!-- Page header -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="System Overview" Style="{StaticResource DisplayMediumText}" />
                    <TextBlock Text="Hardware status and optimization opportunities"
                               Style="{StaticResource BodySecondaryText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding SystemStatus}"
                               Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Analyze My PC"
                            Style="{StaticResource SaturnPrimaryButton}"
                            Command="{Binding AnalyzePcCommand}" />
                    <Button Content="Refresh system" Margin="10,0,0,0"
                            Style="{StaticResource SaturnGhostButton}"
                            Command="{Binding RefreshSystemCommand}"
                            IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Grid>

            <!-- System info grid — 3 columns -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0" Style="{StaticResource SaturnCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="PROCESSOR" Style="{StaticResource HeadingSmallText}" Opacity="0.6" />
                        </StackPanel>
                        <TextBlock Text="{Binding CpuDisplay}"
                                   Style="{StaticResource HeadingMediumText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Snapshot.CpuCurrentUtilizationPercent, StringFormat={}{0:F1}% utilization}"
                                   Style="{StaticResource BodySecondaryText}" Margin="0,6,0,0" />
                        <ProgressBar Value="{Binding Snapshot.CpuCurrentUtilizationPercent}"
                                     Maximum="100"
                                     Style="{StaticResource SaturnProgressBar}"
                                     Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Grid.Column="2" Style="{StaticResource SaturnCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="◈" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="GRAPHICS" Style="{StaticResource HeadingSmallText}" Opacity="0.6" />
                        </StackPanel>
                        <TextBlock Text="{Binding GpuDisplay}"
                                   Style="{StaticResource HeadingMediumText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="HAGS: Enabled" Style="{StaticResource BodySecondaryText}"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding Snapshot.HagsEnabled, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="4" Style="{StaticResource SaturnCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="▦" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="MEMORY" Style="{StaticResource HeadingSmallText}" Opacity="0.6" />
                        </StackPanel>
                        <TextBlock Text="{Binding RamDisplay}"
                                   Style="{StaticResource HeadingMediumText}"
                                   TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding Snapshot.MemoryUsagePercent}"
                                     Maximum="100"
                                     Style="{StaticResource SaturnProgressBar}"
                                     Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- System details — 2 columns -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- OS + System -->
                <Border Grid.Column="0" Style="{StaticResource SaturnCard}">
                    <StackPanel>
                        <TextBlock Text="SYSTEM" Style="{StaticResource HeadingSmallText}"
                                   Opacity="0.6" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="OS"
                                       Style="{StaticResource CaptionText}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OsDisplay}"
                                       Style="{StaticResource BodySecondaryText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Motherboard"
                                       Style="{StaticResource CaptionText}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding Snapshot.MotherboardProduct}"
                                       Style="{StaticResource BodySecondaryText}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Power Plan"
                                       Style="{StaticResource CaptionText}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PowerDisplay}"
                                       Style="{StaticResource BodySecondaryText}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Network"
                                       Style="{StaticResource CaptionText}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding NetworkDisplay}"
                                       Style="{StaticResource BodySecondaryText}" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Storage"
                                       Style="{StaticResource CaptionText}" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding StorageDisplay}"
                                       Style="{StaticResource BodySecondaryText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Optimization Suggestions -->
                <Border Grid.Column="2" Style="{StaticResource SaturnCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="OPTIMIZATION OPPORTUNITIES"
                                       Style="{StaticResource HeadingSmallText}" Opacity="0.6" />
                            <TextBlock Text="{Binding PendingCount, StringFormat={}{0} pending}"
                                       Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Loading state -->
                        <TextBlock Text="No analysis results yet. Saturn will scan your detected hardware and list compatible improvements automatically."
                                   Style="{StaticResource BodySecondaryText}"
                                   Visibility="{Binding Suggestions.Count, Converter={StaticResource ZeroToVis}}" />

                        <ProgressBar IsIndeterminate="True" Height="2"
                                     Foreground="{StaticResource AccentPrimaryBrush}"
                                     Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"
                                     Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12,10"
                                            Background="{StaticResource BackgroundElevatedBrush}"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}"
                                                           Style="{StaticResource HeadingMediumText}"
                                                           FontSize="13" />
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource BodySecondaryText}"
                                                           FontSize="12" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource StatusBadgeAccent}"
                                                    VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentTertiaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Windows Capabilities Bar -->
            <Border Style="{StaticResource SaturnCard}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Game Mode" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Snapshot.GameModeEnabled, Converter={StaticResource BoolToEnabledText}}"
                                   HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{Binding Snapshot.GameModeEnabled, Converter={StaticResource BoolToStatusBrush}}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="HAGS" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Snapshot.HagsEnabled, Converter={StaticResource BoolToEnabledText}}"
                                   HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="Game DVR" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Snapshot.GameDvREnabled, Converter={StaticResource BoolToEnabledText}}"
                                   HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="VBS / HVCI" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Snapshot.VbsEnabled, Converter={StaticResource BoolToEnabledText}}"
                                   HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Text="Admin Mode" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Snapshot.IsRunningAsAdministrator, Converter={StaticResource BoolToEnabledText}}"
                                   HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
