<Page x:Class="SaturnTweaks.UI.Views.PerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBaseBrush}"
      Title="Performance">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Left: Tweak list -->
        <DockPanel Grid.Column="0" Margin="32,28,16,28">

            <!-- Header + controls -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Performance" Style="{StaticResource DisplayMediumText}" />
                    <TextBlock Text="Review every proposed Windows setting before applying it. Selecting a row only previews; it does not change your PC."
                               Style="{StaticResource BodySecondaryText}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="Apply Selected" Style="{StaticResource SaturnPrimaryButton}"
                            Command="{Binding ApplySelectedCommand}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                    <Button Content="Select Recommended" Margin="10,0,0,0"
                            Style="{StaticResource SaturnGhostButton}"
                            Command="{Binding SelectRecommendedCommand}" />
                    <Button Content="Select All" Margin="8,0,0,0"
                            Style="{StaticResource SaturnGhostButton}"
                            Command="{Binding SelectAllCommand}" />
                    <Button Content="Clear" Margin="8,0,0,0"
                            Style="{StaticResource SaturnGhostButton}"
                            Command="{Binding DeselectAllCommand}" />

                    <!-- Dry run toggle -->
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource SaturnToggle}"
                                  IsChecked="{Binding DryRunMode}" />
                        <TextBlock Text="Dry Run" Margin="8,0,0,0"
                                   Style="{StaticResource BodySecondaryText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Progress indicator -->
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                         Height="2" Margin="0,0,0,12"
                         Foreground="{StaticResource AccentPrimaryBrush}"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

            <!-- Session summary -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource BackgroundElevatedBrush}"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding SessionSummary, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding SessionSummary}"
                           Style="{StaticResource BodySecondaryText}" />
            </Border>

            <!-- Tweak list -->
            <ScrollViewer Style="{StaticResource SaturnScrollViewer}">
                <ItemsControl ItemsSource="{Binding Tweaks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TweakRowCard}"
                                    Tag="{Binding IsPreviewed}"
                                    MouseLeftButtonDown="TweakRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding IsApplicable}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0" />

                                    <!-- Name + description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource HeadingMediumText}"
                                                   FontSize="14" />
                                        <TextBlock Text="{Binding ShortDescription}"
                                                   Style="{StaticResource BodySecondaryText}"
                                                   FontSize="12" Margin="0,2,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="⚠ Requires restart"
                                                       FontSize="11"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       Margin="0,0,8,0"
                                                       Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="🛡 Admin required"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InfoBrush}"
                                                       Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Risk badge -->
                                    <Border Grid.Column="2" Padding="6,3" CornerRadius="4"
                                            Margin="8,0" VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding RiskColor}" Opacity="0.15" />
                                        </Border.Background>
                                        <TextBlock Text="{Binding Risk}"
                                                   FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding RiskColor}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>

                                    <!-- Status -->
                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" MinWidth="80"
                                               TextAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Right: Detail panel -->
        <Border Grid.Column="1"
                Background="{StaticResource BackgroundElevatedBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1,0,0,0"
                Padding="24,28">
            <ScrollViewer Style="{StaticResource SaturnScrollViewer}">
                <StackPanel>
                    <TextBlock Text="PREVIEW BEFORE APPLYING" Style="{StaticResource HeadingSmallText}"
                               Opacity="0.5" Margin="0,0,0,20" />

                    <!-- Empty state -->
                    <TextBlock Text="Select a tweak to preview the exact setting, current state, benefit, and trade-offs. Previewing never changes Windows."
                               Style="{StaticResource BodySecondaryText}"
                               Visibility="{Binding SelectedTweak, Converter={StaticResource NullToVis}}" />

                    <!-- Detail content (shown when a tweak is selected) -->
                    <StackPanel Visibility="{Binding SelectedTweak, Converter={StaticResource NotNullToVis}}">
                        <TextBlock Text="{Binding SelectedTweak.DisplayName}"
                                   Style="{StaticResource HeadingLargeText}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding SelectedTweak.Category}"
                                   Style="{StaticResource CaptionText}" Margin="0,4,0,16" />

                        <TextBlock Text="PRE-APPLY PREVIEW — NO CHANGES MADE" FontSize="10"
                                   FontWeight="Bold" Foreground="{StaticResource AccentTertiaryBrush}"
                                   Margin="0,0,0,14" TextWrapping="Wrap" />
                        <TextBlock Text="Planned change" Style="{StaticResource HeadingSmallText}"
                                   Opacity="0.65" Margin="0,0,0,6" />
                        <Border Background="{StaticResource BackgroundCardBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="10,8" Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedTweak.ProposedChange}"
                                       Style="{StaticResource MonoValueText}" FontSize="11"
                                       TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="Windows setting location" Style="{StaticResource HeadingSmallText}"
                                   Opacity="0.65" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SelectedTweak.ChangeLocation}"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Margin="0,0,0,14" />
                        <TextBlock Text="Current Value" Style="{StaticResource HeadingSmallText}"
                                   Opacity="0.5" Margin="0,0,0,6" />
                        <Border Background="{StaticResource BackgroundCardBrush}"
                                CornerRadius="6" Padding="10,7" Margin="0,0,0,16">
                            <TextBlock Text="{Binding SelectedTweak.CurrentValue}"
                                       Style="{StaticResource MonoValueText}" FontSize="12" />
                        </Border>

                        <TextBlock Text="What This Does" Style="{StaticResource HeadingSmallText}"
                                   Opacity="0.5" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SelectedTweak.DetailedExplanation}"
                                   Style="{StaticResource BodySecondaryText}" Margin="0,0,0,16" />

                        <TextBlock Text="Expected Benefit" Style="{StaticResource HeadingSmallText}"
                                   Opacity="0.5" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SelectedTweak.ExpectedBenefit}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <TextBlock Text="Trade-offs" Style="{StaticResource HeadingSmallText}"
                                   Opacity="0.5" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SelectedTweak.PotentialDisadvantages}"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
