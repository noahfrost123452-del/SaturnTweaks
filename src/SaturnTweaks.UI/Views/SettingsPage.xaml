<Page x:Class="SaturnTweaks.UI.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBaseBrush}"
      Title="Settings">

    <ScrollViewer Style="{StaticResource SaturnScrollViewer}" Padding="32,28,32,32">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource DisplayMediumText}" />
            <TextBlock Text="Application preferences, data management, and version info"
                       Style="{StaticResource BodySecondaryText}" Margin="0,4,0,24" />

            <!-- Behaviour -->
            <Border Style="{StaticResource SaturnCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="BEHAVIOUR" Style="{StaticResource HeadingSmallText}"
                               Opacity="0.5" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Show confirmation before applying tweaks"
                                       Style="{StaticResource BodySecondaryText}" />
                            <TextBlock Text="Recommended — shows exactly what will change"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SaturnToggle}"
                                  IsChecked="{Binding ConfirmBeforeApply}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Launch minimized to system tray"
                                       Style="{StaticResource BodySecondaryText}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SaturnToggle}"
                                  IsChecked="{Binding LaunchMinimized}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Show notifications on tweak completion"
                                       Style="{StaticResource BodySecondaryText}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SaturnToggle}"
                                  IsChecked="{Binding ShowNotifications}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Data Management -->
            <Border Style="{StaticResource SaturnCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="DATA MANAGEMENT" Style="{StaticResource HeadingSmallText}"
                               Opacity="0.5" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Data folder" Style="{StaticResource BodySecondaryText}" />
                            <TextBlock Text="{Binding DataFolder}" Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open Folder"
                                Style="{StaticResource SaturnGhostButton}"
                                Command="{Binding OpenDataFolderCommand}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Clear optimization history"
                                       Style="{StaticResource BodySecondaryText}" />
                            <TextBlock Text="Removes all recorded change history (rollback will no longer be possible)"
                                       Style="{StaticResource CaptionText}" Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Clear History"
                                Style="{StaticResource SaturnGhostButton}"
                                Command="{Binding ClearHistoryCommand}"
                                VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Privacy note -->
            <Border Style="{StaticResource SaturnCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="PRIVACY" Style="{StaticResource HeadingSmallText}"
                               Opacity="0.5" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource BodySecondaryText}" TextWrapping="Wrap">
                        Saturn Tweaks makes no network connections except DNS resolution tests
                        you explicitly initiate on the Network page. No telemetry, no analytics,
                        no cloud services, no data collection. All data is stored locally
                        in the data folder above.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource SaturnCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ABOUT" Style="{StaticResource HeadingSmallText}"
                               Opacity="0.5" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Application"
                                   Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppName}"
                                   Style="{StaticResource BodySecondaryText}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Version"
                                   Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AppVersion}"
                                   Style="{StaticResource MonoValueText}" FontSize="13" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Save button + status -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Save Settings" Style="{StaticResource SaturnPrimaryButton}"
                        Command="{Binding SaveSettingsCommand}" />
                <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource BodySecondaryText}"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
